{
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/:path((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/process-course-source.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs"
